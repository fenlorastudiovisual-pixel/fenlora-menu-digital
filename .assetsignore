# Wrangler NO excluye esto automáticamente (no lee .gitignore).
# Cualquier archivo que NO esté aquí se sube como asset público del sitio.

# Control de versiones y config interna — nunca deben ser públicos
.git/
.gitignore
.wrangler/
node_modules/

# Carpeta sobrante de una sesión vieja, no es parte del sitio
mnt/

# Archivos residuales (respaldo por si aún quedan en la carpeta) — no son del sitio
*.rar
assetsignore

# Migraciones de base de datos y documentación interna — no son del sitio público
*.sql
*.md
wrangler.toml